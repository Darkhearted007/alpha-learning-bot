generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trade {
  id            Int      @id @default(autoincrement())
  cycle         Int
  pair          String
  action        String
  entryReason   String   @map("entry_reason")
  exitReason    String   @map("exit_reason")
  status        String
  pnl           Float
  tags          String
  marketContext Json     @map("market_context")
  confidence    Float
  strategy      String
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("trades")
}
